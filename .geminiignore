# .geminiignore
# Files and directories that must NEVER be sent to Gemini CLI.
# For other AI tools, apply equivalent rules (e.g., .cursorignore, .copilotignore).
# See SAFETY.md for the full context exclusion policy.

# --- SECRETS & PRIVACY (HIGH RISK) ---
.env
.env.*
*.pem
*.key
*.p12
*.pub
secrets.json
credentials.json
auth.json
.netrc

# --- DEPENDENCIES (TOKEN COST) ---
node_modules/
vendor/
.venv/
venv/
env/
virtualenv/
lib/python*/

# --- BUILD ARTIFACTS & CACHE ---
dist/
build/
out/
.next/
.nuxt/
.cache/
*.pyc
*.pyo
__pycache__/

# --- LOCK FILES (NOT USEFUL FOR QUESTIONS) ---
package-lock.json
yarn.lock
pnpm-lock.yaml
composer.lock
poetry.lock
Cargo.lock

# --- LOGS & DATABASES ---
*.log
*.sqlite
*.db
*.sql
*.dump

# --- IDE & SYSTEM FILES ---
.git/
.vscode/
.idea/
.DS_Store
Thumbs.db

# --- MEDIA & BINARIES ---
*.png
*.jpg
*.jpeg
*.gif
*.pdf
*.zip
*.tar.gz
*.exe
*.bin